      "name": "News Articles",
      "item": [
        {
          "name": "List News",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/news?per_page=10&search_title=hotel",
              "host": ["{{base_url}}"],
              "path": ["news"],
              "query": [
                {"key": "per_page", "value": "10"},
                {"key": "search_title", "value": "hotel"},
                {"key": "category_id", "value": "1", "disabled": true},
                {"key": "status", "value": "1", "disabled": true}
              ]
            }
          }
        },
        {
          "name": "Get Single News",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/news/kham-pha-khong-gian-sang-trong-tai-lavishstay-resort",
