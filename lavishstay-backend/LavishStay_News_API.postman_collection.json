            }
          }
        },
        {
          "name": "Create News",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test News Article\",\n  \"slug\": \"test-news-article\",\n  \"summary\": \"This is a test summary\",\n  \"content\": \"<p>This is the full content of the test article.</p>\",\n  \"tags\": [\"test\", \"sample\"],\n  \"category_id\": 1,\n  \"meta_title\": \"Test News Article - LavishStay\",\n  \"meta_description\": \"Test article description for SEO\",\n  \"status\": 1,\n  \"published_at\": \"2024-12-01 10:00:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/news",
              "host": ["{{base_url}}"],
              "path": ["news"]
            }
          }
        },
        {
          "name": "Get Popular News",
